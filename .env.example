APP_NAME="R-Line API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_PORT=8080

APP_LOCALE=ru
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ru_RU
APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=rline
DB_USERNAME=rline
DB_PASSWORD=rline_local
FORWARD_DB_PORT=5433

SESSION_DRIVER=tenant-database
SESSION_LIFETIME=30
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

MAIL_MAILER=log
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

FRONTEND_URL=http://localhost:5173
SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173,localhost:8080,127.0.0.1:8080
AUTH_LOCAL_ENABLED=true
AUTH_LDAP_ENABLED=false
LDAP_URI=
LDAP_BASE_DN=
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=
LDAP_START_TLS=true
AUTH_AD_ENABLED=false
AD_URI=
AD_BASE_DN=
AD_BIND_DN=
AD_BIND_PASSWORD=
AD_START_TLS=true
AUTH_MULTIFACTOR_ENABLED=false
MULTIFACTOR_ISSUER=
MULTIFACTOR_DISCOVERY_URL=https://api.multifactor.ru/.well-known/openid-configuration
MULTIFACTOR_CLIENT_ID=
MULTIFACTOR_CLIENT_SECRET=
MULTIFACTOR_CALLBACK=http://localhost:8080/auth/multifactor/callback
